# Telegram bot token from @BotFather
BOT_TOKEN=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tron_energy
DB_USER=tronbot
DB_PASSWORD=CHANGE_ME

# Web server
HOST=127.0.0.1
PORT=3080
SHUTDOWN_TIMEOUT_MS=15000
PUBLIC_BASE_URL=https://bot.example.com
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
ADMIN_PASSWORD_HASH=

# TRON network. Mainnet default; use Shasta for testing.
TRON_API_BASE=https://api.trongrid.io
TRONGRID_API_KEY=
# V3.1 resumable scan/backfill controls
TRON_SCAN_PAGE_SIZE=200
TRON_SCAN_MAX_PAGES=5
TRON_SCAN_OVERLAP_MS=300000
TRON_INITIAL_BACKFILL_HOURS=24
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_USDT_DECIMALS=6
TRON_CONFIRMATIONS_REQUIRED=19

# Business rules
REFERRAL_COMMISSION_PERCENT=3
MIN_DEPOSIT=1
ENERGY_PROVIDER_MODE=disabled

# V2.1: withdrawal paid status requires confirmed chain transfer verification
# Keep disabled until independent validation and security testing are complete
AUTO_CREDIT_CONFIRMED=false

# V1.8: optional scheduled audit alerts (disabled by default)
CHAIN_ALERTS_ENABLED=false
CHAIN_AUDIT_INTERVAL_SECONDS=900
# Telegram numeric chat IDs for admins, comma-separated (e.g. 123456789,-1001234567890)
ADMIN_TELEGRAM_IDS=

# V2.6 shared MySQL-backed login brute-force protection; fresh installs create the table from schema.sql, upgrades run sql/migrate_v2_6.sql
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
LOGIN_LOCK_MS=900000

# V2.5 RBAC: roles live in admin_users.role; env-based emergency account is always super_admin.
# Roles: super_admin, finance, operator, auditor. DB admin accounts are created by super_admin.

# V2.8 encrypted backups (required for backups; plaintext backups are disabled)
# Generate identity: age-keygen -o /root/.config/tron-energy-bot/age-identity.txt
# Get recipient: age-keygen -y /root/.config/tron-energy-bot/age-identity.txt
AGE_RECIPIENT=
AGE_IDENTITY_FILE=/root/.config/tron-energy-bot/age-identity.txt
RETENTION_DAYS=14
BACKUP_ROOT=/var/backups/tron-energy-bot
# Optional rclone destination, e.g. remote:bucket. Configure rclone for root first.
# RCLONE_REMOTE=remote:
# RCLONE_PATH=tron-energy-bot


# V2.9 operational monitor (systemd timer every 5 minutes)
BACKUP_MAX_AGE_HOURS=30
DISK_WARN_PERCENT=85
# Optional overrides for manual runs
# HEALTH_URL=http://127.0.0.1:3080/health
# OPS_MONITOR_STATE_FILE=/var/lib/tron-energy-bot/ops-monitor-state

# V3.2 event-only; requires an external trusted provider that POSTs signed event hints.
TRON_EVENT_ONLY=true
TRON_EVENT_WEBHOOK_SECRET=
# Public webhook endpoint: POST /api/events/tron; header x-tron-signature: sha256=<HMAC-SHA256 of raw JSON body>
# Socket.IO endpoint /socket.io; JWT admin token in auth.token
